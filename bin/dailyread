#!/bin/bash
# Daily Read launcher. Usage: bin/dailyread mockup | run --dry-run | run | render <json> | usage
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
cd "$ROOT"
exec uv run --quiet python -m dailyread "$@"
